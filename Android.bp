cc_prebuilt_library_shared {
// NOTE (Soong analysis, 2026-10-31): libmdnssd was REMOVED from shared_libs below.
// The base defines it in external/mdnsresponder WITHOUT vendor_available, so a vendor
// module may not depend on it -- Soong fails the *static* variant with:
//   depends on //external/mdnsresponder:libmdnssd ... add //vendor/realme/X2 to visibility
// The blob genuinely needs it at runtime (DT_NEEDED, both ABIs), and the base still
// installs libmdnssd.so to /system, which the default namespace resolves for system_ext
// libs -- so dropping the build-time declaration is correct, not a workaround.
// Guarded by lint C81 (vendor shared_libs must be vendor_available in the base).
    name: "libmiracastsystem",
    owner: "realme",
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: [
                "proprietary/system_ext/lib/libmiracastsystem.so",
            ],
            shared_libs: [
                "libcutils",
                "libhardware_legacy",
                "libmmosal",
                "libutils",
                "libmedia",
                "libbinder",
                "libnetutils",
                "libwfdclient",
                "libaudioclient",
                "liblog",
                "libkeystore_binder",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
        android_arm64: {
            srcs: [
                "proprietary/system_ext/lib64/libmiracastsystem.so",
            ],
            shared_libs: [
                "libcutils",
                "libhardware_legacy",
                "libmmosal",
                "libutils",
                "libmedia",
                "libbinder",
                "libnetutils",
                "libwfdclient",
                "libaudioclient",
                "liblog",
                "libkeystore_binder",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "both",
    prefer: true,
    system_ext_specific: true,
}

