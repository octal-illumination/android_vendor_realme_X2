// MANUAL POST-GENERATION ADD -- re-apply after any extract-utils --regenerate_makefiles run.
// The stock F.26 blobs carry DT_NEEDED on the VERSIONED sonames libprotobuf-cpp-{lite,full}-3.9.1.so,
// and 21 prebuilts below link them. extract-utils rewrote those deps to
// "libprotobuf-cpp-*-3.9.1-vendorcompat", a module that existed in Android 11-13 but is GONE in
// A16 (external/protobuf @android16-release defines only the unversioned libprotobuf-cpp-lite/-full),
// so every one of those shared_libs was undefined => Soong abort. The modules are named after the
// exact runtime soname instead, so build dependency and DT_NEEDED both agree.


// REVERTED 2026-10-29: libqti_vndfwk_detect and libvndfwk_detect_jni.qti were shipped here on the
// mistaken conclusion that NO synced repo builds them. They ARE built - by hardware/qcom-caf/common
// (fwk-detect/Android.bp) as system_ext modules. Shipping vendor prebuilts of the same names caused
// the build failure "partition is different: system_ext(libqti_vndfwk_detect) != vendor(prebuilt_...)".
// The miss: the search covered the three caf sm8150 repos and the qcom display repos but NOT
// hardware/qcom-caf/common. Another under-search false negative (LL-038).

// ---------------------------------------------------------------------------
// NOTE (Soong analysis failure, 2026-10-31): libmiracastsystem declares
//   shared_libs ["libkeystore_binder"]
// but LOS 23.2 / A16 provides NO module by that name -- keystore1 was dropped when
// keystore2 replaced it. Checked against the real tree's module index (49,315 modules):
// libkeystore_binder, libkeystore_aidl and libkeystore_parcelables are ALL absent.
// F.26 ships all three in /system/lib{,64}; our blobs genuinely need them (DT_NEEDED),
// so we SHIP the OEM libraries rather than drop the dependency.
// Full transitive closure resolved and verified: the other 17 dependencies are all
// provided by the base tree, so these three are sufficient.
// Guarded by lint C23 (vendor DT_NEEDED closure vs the base module index).
// ---------------------------------------------------------------------------

cc_prebuilt_library_shared {
    name: "libkeystore_binder",
    owner: "realme",
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: [
                "proprietary/system_ext/lib/libkeystore_binder.so",
            ],
            shared_libs: [
                "android.hardware.keymaster@4.0",
                "libbinder",
                "libc",
                "libc++",
                "libdl",
                "libhidlbase",
                "libkeymaster4support",
                "libkeystore_aidl",
                "libkeystore_parcelables",
                "liblog",
                "libm",
                "libprotobuf-cpp-lite",
                "libutils",
            ],
        },
        android_arm64: {
            srcs: [
                "proprietary/system_ext/lib64/libkeystore_binder.so",
            ],
            shared_libs: [
                "android.hardware.keymaster@4.0",
                "libbinder",
                "libc",
                "libc++",
                "libdl",
                "libhidlbase",
                "libkeymaster4support",
                "libkeystore_aidl",
                "libkeystore_parcelables",
                "liblog",
                "libm",
                "libprotobuf-cpp-lite",
                "libutils",
            ],
        },
    },
    compile_multilib: "both",
    prefer: true,
    system_ext_specific: true,
}

