cc_prebuilt_library_shared {
    name: "com.dsi.ant@1.0",
    owner: "realme",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: [
                "proprietary/vendor/lib64/com.dsi.ant@1.0.so",
            ],
            shared_libs: [
                "libhidlbase",
                "liblog",
                "libutils",
                "libcutils",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "64",
    prefer: true,
    // FIX 2026-10-29 (corpus evidence): the base defines com.dsi.ant@1.0 as a hidl_interface in
    // external/ant-wireless/hidl/interfaces/ant/1.0, with NO specificity flag => PartitionTag
    // "system". soc_specific here => "vendor" => Soong aborts with
    // "partition is different: system(com.dsi.ant@1.0) != vendor(prebuilt_com.dsi.ant@1.0)".
    // vendor_available keeps PartitionTag at "system" (matching the source, exactly as the
    // hidl_interface-generated module does internally) while still producing the vendor variant
    // that installs to /vendor/lib64. Same mechanism as the fingerprint HAL fix (C58).
    vendor_available: true,
}

